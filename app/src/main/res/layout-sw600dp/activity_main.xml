<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/coordinator_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/amoled_black">

    <!-- AppBar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/amoled_black"
        app:elevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="12dp"
            android:paddingBottom="6dp">

            <!-- Title & Version Badge -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_app_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp"
                    android:letterSpacing="-0.02"
                    android:textStyle="bold" />

                <!-- Version Badge under App Name -->
                <TextView
                    android:id="@+id/tv_app_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:background="@drawable/bg_status_badge"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="@string/app_version"
                    android:textColor="#0F172A"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Settings Icon Button -->
            <ImageButton
                android:id="@+id/btn_settings"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/title_appearance_settings"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_settings"
                app:tint="#FFFFFF" />

        </LinearLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Device & Service Status Strip -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="8dp"
        app:cardBackgroundColor="@color/amoled_card_bg"
        app:cardCornerRadius="16dp"
        app:strokeColor="@color/amoled_stroke"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp">

            <ImageView
                android:id="@+id/iv_status_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_check_circle"
                app:tint="@color/status_green_active" />

            <TextView
                android:id="@+id/tv_service_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/status_wallpaper_active"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <View
                android:id="@+id/divider_status"
                android:layout_width="1dp"
                android:layout_height="18dp"
                android:layout_marginHorizontal="16dp"
                android:background="@color/amoled_stroke" />

            <ImageView
                android:id="@+id/iv_device_state_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_phone_inner"
                app:tint="@color/amoled_accent" />

            <TextView
                android:id="@+id/tv_device_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/device_state_unfolded"
                android:textColor="@color/amoled_accent"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_aspect_ratio_diag"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="0.96 (Unfolded Inner Display)"
                android:textColor="#C8CAD2"
                android:textSize="12sp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Dual Pane Horizontal Row - Fills 100% of the Available Height -->
    <LinearLayout
        android:id="@+id/content_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:paddingHorizontal="24dp"
        android:paddingBottom="8dp">

        <!-- Left Column: Card 1 (Cover Screen Wallpaper) - Height match_parent -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_cover"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            app:cardBackgroundColor="@color/amoled_card_bg"
            app:cardCornerRadius="18dp"
            app:strokeColor="@color/amoled_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/iv_cover_icon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_phone_cover"
                        app:tint="@color/amoled_accent" />

                    <TextView
                        android:id="@+id/tv_cover_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="@string/section_cover_screen"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/badge_cover_ratio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_status_badge"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="3dp"
                        android:text="9:20 Cover"
                        android:textColor="#0F172A"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_cover_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/desc_cover_screen"
                    android:textColor="#C8CAD2"
                    android:textSize="12sp" />

                <!-- Vertically Centered Preview & Controls Horizontal Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_preview_cover"
                        android:layout_width="100dp"
                        android:layout_height="218dp"
                        android:layout_gravity="center_vertical"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="1.5dp"
                        app:strokeColor="@color/preview_border_dark"
                        app:cardBackgroundColor="@color/preview_placeholder_bg">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <ImageView
                                android:id="@+id/iv_preview_cover"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:contentDescription="@string/section_cover_screen" />

                            <TextView
                                android:id="@+id/tv_placeholder_cover"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:gravity="center"
                                android:padding="6dp"
                                android:text="Default\nSystem"
                                android:textColor="#8E929E"
                                android:textSize="12sp" />

                            <!-- Punch-hole Camera Simulation -->
                            <View
                                android:id="@+id/dot_camera_cover"
                                android:layout_width="7dp"
                                android:layout_height="7dp"
                                android:layout_gravity="top|center_horizontal"
                                android:layout_marginTop="6dp"
                                android:background="@drawable/bg_camera_punch" />

                        </FrameLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="vertical">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_pick_cover"
                            style="@style/Widget.Material3.Button"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:text="@string/btn_select_image"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            app:icon="@drawable/ic_image_picker"
                            app:iconGravity="textStart"
                            app:iconSize="20dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_reset_cover"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:layout_marginTop="8dp"
                            android:text="@string/btn_remove_image"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            app:icon="@drawable/ic_refresh"
                            app:iconGravity="textStart"
                            app:iconSize="16dp" />

                        <TextView
                            android:id="@+id/tv_cover_scale_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/scale_mode_title"
                            android:textColor="#D8DAE2"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButtonToggleGroup
                            android:id="@+id/toggle_cover_scale"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_marginTop="4dp"
                            app:singleSelection="true"
                            app:selectionRequired="true"
                            app:checkedButton="@+id/btn_cover_crop">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_cover_crop"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:paddingHorizontal="4dp"
                                android:paddingVertical="0dp"
                                android:text="@string/scale_crop_short"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_cover_fit"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:paddingHorizontal="4dp"
                                android:paddingVertical="0dp"
                                android:text="@string/scale_fit_short"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                        </com.google.android.material.button.MaterialButtonToggleGroup>
                    </LinearLayout>

                </LinearLayout>

                <!-- Footer Status Detail Strip -->
                <LinearLayout
                    android:id="@+id/container_cover_status_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_status_badge"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp">

                    <ImageView
                        android:id="@+id/iv_cover_status_dot"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:src="@drawable/ic_check_circle"
                        app:tint="@color/status_green_active" />

                    <TextView
                        android:id="@+id/tv_status_cover_detail"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/status_default_image"
                        android:textColor="#0F172A"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Right Column: Card 2 (Inner Screen Wallpaper) - Height match_parent -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_inner"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            app:cardBackgroundColor="@color/amoled_card_bg"
            app:cardCornerRadius="18dp"
            app:strokeColor="@color/amoled_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/iv_inner_icon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_phone_inner"
                        app:tint="@color/amoled_accent" />

                    <TextView
                        android:id="@+id/tv_inner_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="@string/section_inner_screen"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/badge_inner_ratio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_status_badge"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="3dp"
                        android:text="~1:1 Inner"
                        android:textColor="#0F172A"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_inner_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/desc_inner_screen"
                    android:textColor="#C8CAD2"
                    android:textSize="12sp" />

                <!-- Vertically Centered Preview & Controls Horizontal Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_preview_inner"
                        android:layout_width="160dp"
                        android:layout_height="152dp"
                        android:layout_gravity="center_vertical"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="1.5dp"
                        app:strokeColor="@color/preview_border_dark"
                        app:cardBackgroundColor="@color/preview_placeholder_bg">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <ImageView
                                android:id="@+id/iv_preview_inner"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:contentDescription="@string/section_inner_screen" />

                            <TextView
                                android:id="@+id/tv_placeholder_inner"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:gravity="center"
                                android:padding="6dp"
                                android:text="Default\nSystem"
                                android:textColor="#8E929E"
                                android:textSize="12sp" />

                            <!-- Inner Fold Center Line Simulation -->
                            <View
                                android:id="@+id/divider_inner_fold"
                                android:layout_width="1dp"
                                android:layout_height="match_parent"
                                android:layout_gravity="center_horizontal"
                                android:alpha="0.2"
                                android:background="#FFFFFF" />

                        </FrameLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="vertical">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_pick_inner"
                            style="@style/Widget.Material3.Button"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:text="@string/btn_select_image"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            app:icon="@drawable/ic_image_picker"
                            app:iconGravity="textStart"
                            app:iconSize="20dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_reset_inner"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:layout_marginTop="8dp"
                            android:text="@string/btn_remove_image"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            app:icon="@drawable/ic_refresh"
                            app:iconGravity="textStart"
                            app:iconSize="16dp" />

                        <TextView
                            android:id="@+id/tv_inner_scale_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/scale_mode_title"
                            android:textColor="#D8DAE2"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButtonToggleGroup
                            android:id="@+id/toggle_inner_scale"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_marginTop="4dp"
                            app:singleSelection="true"
                            app:selectionRequired="true"
                            app:checkedButton="@+id/btn_inner_crop">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_inner_crop"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:paddingHorizontal="4dp"
                                android:paddingVertical="0dp"
                                android:text="@string/scale_crop_short"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_inner_fit"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:paddingHorizontal="4dp"
                                android:paddingVertical="0dp"
                                android:text="@string/scale_fit_short"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                        </com.google.android.material.button.MaterialButtonToggleGroup>
                    </LinearLayout>

                </LinearLayout>

                <!-- Footer Status Detail Strip -->
                <LinearLayout
                    android:id="@+id/container_inner_status_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_status_badge"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp">

                    <ImageView
                        android:id="@+id/iv_inner_status_dot"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:src="@drawable/ic_check_circle"
                        app:tint="@color/status_green_active" />

                    <TextView
                        android:id="@+id/tv_status_inner_detail"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/status_default_image"
                        android:textColor="#0F172A"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- Bottom Sticky Action Bar with Inset Padding -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottom_bar_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/amoled_card_bg"
        app:cardCornerRadius="0dp"
        app:cardElevation="6dp"
        app:strokeColor="@color/amoled_stroke"
        app:strokeWidth="1dp">

        <LinearLayout
            android:id="@+id/bottom_bar_inner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_apply_wallpaper"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:backgroundTint="@color/amoled_accent"
                android:textColor="@color/amoled_on_accent"
                android:textSize="16sp"
                android:textStyle="bold"
                app:icon="@drawable/ic_wallpaper_thumb"
                app:iconTint="@color/amoled_on_accent"
                android:text="@string/btn_apply_wallpaper" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
